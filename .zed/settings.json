{
  "languages": {
    "Python": {
      "tab_size": 4,
      "language_servers": {
        "pyright": {},
        "rust-analyzer": null
      }
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "interpreterPath": ".venv/bin/python",
          "pythonPaths": ["src"]
        },
        "typeCheckingMode": "strict"
      }
    },
    "ruff": {
      "settings": {
        "fixAll": ["source.fixAll.ruff", "source.organizeImports.ruff"]
      }
    }
  },
  "formatters": {
    "python": {
      "formatter": "language_server",
      "language_servers": ["ruff"],
      "format_on_save": "on"
    }
  },
  "vim_mode": false
}
